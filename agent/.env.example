# --- Proveedor de modelo multimodal (VisionAgent / CatalogAgent) ---
# model_provider: bedrock | gemini | chatgpt | ollama
# Vacío = modo automático: se prueba cada proveedor en orden
# (bedrock -> gemini -> chatgpt -> ollama) con una llamada real mínima;
# el primero que responde gana y esa elección se cachea para el resto del
# proceso. Si se fija un valor, SOLO se intenta ese proveedor: si falla, se
# propaga el error (sin fallback a los demás). Ver model_provider.py.
SNAPFLICK_MODEL_PROVIDER=

# --- Bedrock ---
# Requiere credenciales AWS estándar (ver bloque AWS más abajo) con acceso al
# modelo. model_id es un Bedrock model/inference-profile id, p.ej.:
#   us.anthropic.claude-sonnet-4-5-20250929-v1:0
#   us.amazon.nova-pro-v1:0
SNAPFLICK_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Gemini ---
# API key en https://aistudio.google.com
# model_id, p.ej.: gemini-2.5-flash | gemini-2.5-flash-lite | gemini-2.5-pro
SNAPFLICK_GEMINI_API_KEY=
SNAPFLICK_GEMINI_MODEL_ID=gemini-2.5-flash

# --- ChatGPT (OpenAI) ---
# API key en https://platform.openai.com/api-keys
# model_id debe soportar imágenes (VisionAgent lee fotos), p.ej.:
#   gpt-4o-mini | gpt-4o | gpt-4.1 | gpt-4.1-mini
SNAPFLICK_CHATGPT_API_KEY=
SNAPFLICK_CHATGPT_MODEL_ID=gpt-4o-mini

# --- Ollama (servidor local u on-prem) ---
# host: URL del servidor Ollama (por defecto, el que corre en tu máquina)
# model_id debe soportar imágenes, p.ej.: llama3.2-vision | llava | qwen2.5vl
SNAPFLICK_OLLAMA_HOST=http://localhost:11434
SNAPFLICK_OLLAMA_MODEL_ID=llama3.2-vision

# --- AWS (credenciales estándar) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Almacenamiento ---
# Vacío = disco local bajo SNAPFLICK_DATA_DIR (desarrollo).
# Con valor (nombre del bucket) = las imágenes y el catálogo también se suben
# a S3 y se sirven desde ahí (URLs firmadas); ver tools/storage_tools.py.
SNAPFLICK_S3_BUCKET=
SNAPFLICK_AWS_REGION=us-east-1
SNAPFLICK_DATA_DIR=./data

# --- Procesamiento de imagen ---
# rembg_model: modelo de recorte de fondo (rembg), p.ej.:
#   isnet-general-use | u2net | u2netp | silueta
SNAPFLICK_REMBG_MODEL=isnet-general-use
SNAPFLICK_CANVAS_SIZE=1200
SNAPFLICK_PRODUCT_MARGIN=0.10
SNAPFLICK_THUMBNAIL_SIZE=400

# --- App ---
SNAPFLICK_MAX_IMAGES_PER_JOB=30
# log_level: DEBUG | INFO | WARNING | ERROR | CRITICAL
SNAPFLICK_LOG_LEVEL=INFO
