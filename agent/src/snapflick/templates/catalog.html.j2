<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root { --ink:#1a1a1a; --muted:#6b6b6b; --line:#e6e6e6; --bg:#fafafa; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--bg); color:var(--ink);
         font:16px/1.55 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }
  header { padding:56px 24px 32px; max-width:1100px; margin:0 auto; }
  h1 { font-size:2.1rem; margin:0 0 8px; letter-spacing:-.02em; }
  header p { color:var(--muted); margin:0; max-width:60ch; }
  main { max-width:1100px; margin:0 auto; padding:0 24px 72px; }
  h2 { font-size:1.05rem; text-transform:uppercase; letter-spacing:.08em;
       color:var(--muted); margin:48px 0 16px; padding-bottom:8px; border-bottom:1px solid var(--line); }
  .grid { display:grid; gap:20px; grid-template-columns:repeat(auto-fill,minmax(230px,1fr)); }
  .card { background:#fff; border:1px solid var(--line); border-radius:12px; overflow:hidden; }
  .card img { width:100%; aspect-ratio:1; object-fit:cover; display:block; background:#f0f0f0; }
  .body { padding:14px 16px 18px; }
  .brand { font-size:.72rem; text-transform:uppercase; letter-spacing:.06em; color:var(--muted); }
  .name { font-weight:600; margin:2px 0 4px; }
  .pres { font-size:.85rem; color:var(--muted); }
  .desc { font-size:.88rem; margin:10px 0 0; }
  .low { display:inline-block; margin-top:10px; font-size:.72rem; color:#8a6d00;
         background:#fff6d6; border-radius:999px; padding:2px 8px; }
  footer { text-align:center; color:var(--muted); font-size:.85rem; padding:32px 0 64px; }
</style>
</head>
<body>
<header>
  <h1>{{ title }}</h1>
  <p>{{ summary }}</p>
</header>
<main>
{% for category, products in grouped.items() %}
  {% if products %}
  <h2>{{ category }} <span style="font-weight:400">({{ products|length }})</span></h2>
  <div class="grid">
    {% for p in products %}
    <article class="card">
      <img src="{{ image_srcs[p.id] }}" alt="{{ p.sheet.name }}">
      <div class="body">
        {% if p.sheet.brand %}<div class="brand">{{ p.sheet.brand }}</div>{% endif %}
        <div class="name">{{ p.sheet.name }}</div>
        {% if p.sheet.presentation %}<div class="pres">{{ p.sheet.presentation }}</div>{% endif %}
        <p class="desc">{{ p.sheet.description }}</p>
        {% if p.sheet.confidence == 'low' %}<span class="low">Revisar datos</span>{% endif %}
      </div>
    </article>
    {% endfor %}
  </div>
  {% endif %}
{% endfor %}
</main>
<footer>{{ total }} productos · generado con SnapFlick</footer>
</body>
</html>
